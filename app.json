{
  "expo": {
    "name": "Gallery App",
    "slug": "gallery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gallery.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Gallery App saves downloaded images to your photo library."
      }
    },
    "android": {
      "package": "com.gallery.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gallery App to access your photos.",
          "savePhotosPermission": "Allow Gallery App to save downloaded images to your photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9aa9e63-1686-4dae-9186-d2aa5586ccae"
      }
    }
  }
}
